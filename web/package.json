    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run build:cli && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "dotenv": "17.2.3",
    "mature-ts": "file:../cli",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "^4.3.0",
    "typescript": "latest",
    "vite": "latest"
  }
}
